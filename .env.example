# Banco de dados: "json" (padrão, funciona sem instalar nada) ou "mysql"
DB_MODE=json

# Pasta dos arquivos JSON (opcional; padrão: database/json)
# JSON_DATA_DIR=database/json

# MySQL (usado somente com DB_MODE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vidro_export

# Chave secreta para sessões e tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=defina_uma_chave_segura

# Cadastro público ("Criar conta" na tela de login). Novas contas entram como operador.
# Use false para que somente administradores criem usuários.
ALLOW_SIGNUP=true

# Câmbio (API pública Frankfurter)
EXCHANGE_API_URL=https://api.frankfurter.dev/v1
EXCHANGE_TIMEOUT=8

# Servidor
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
